# ============================================================================
# ALUBOX CRM — Variáveis de ambiente (EXEMPLO)
# Copie para ".env.local" e preencha com os valores reais do seu projeto
# Supabase (Project Settings → API). NUNCA faça commit do ".env.local".
# ============================================================================

# --- Supabase: chaves públicas (podem ir ao navegador) ---------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase: chave de serviço (NUNCA expor no cliente) -------------------
# Usada apenas em rotas server-side (ex: app/api/admin/users) para operações
# administrativas como criar usuários. Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Aplicação ---------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Em produção: NEXT_PUBLIC_APP_URL=https://crm.alubox.com.br
